# Aura Control Panel Backend Environment Variables
# Copy this file to .env and update values as needed

PORT=4000

# REQUIRED: MongoDB connection string
MONGO_URI=mongodb+srv://user:password@host/database

# REQUIRED: JWT secret for authentication (use same as Aura backend)
ADMIN_JWT_SECRET=your_secure_jwt_secret_here

# Service URLs
AURA_BACKEND_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:9000
